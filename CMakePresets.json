{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-20",
        "CMAKE_CXX_COMPILER": "clang++-20"
      }
    },
    {
      "name": "debug",
      "displayName": "GCC 14 Debug (Conan)",
      "inherits": [
        "base",
        "gcc"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake"
    },
    {
      "name": "clang-debug",
      "displayName": "Clang 20 Debug (Conan)",
      "inherits": [
        "base",
        "clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake"
    },
    {
      "name": "release",
      "displayName": "GCC 14 Release (Conan)",
      "inherits": [
        "base",
        "gcc"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake"
    },
    {
      "name": "asan-ubsan",
      "displayName": "Clang 20 Debug + ASan/UBSan + fuzzers (Conan)",
      "inherits": [
        "base",
        "clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LCART_SANITIZERS": "address;undefined",
        "LCART_BUILD_FUZZERS": "ON"
      },
      "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake"
    },
    {
      "name": "debug-system",
      "displayName": "GCC 14 Debug, Ubuntu packages, no Conan (offline / air-gapped)",
      "inherits": [
        "base",
        "gcc"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan-ubsan-system",
      "displayName": "Clang 20 Debug + ASan/UBSan + fuzzers, Ubuntu packages, no Conan",
      "inherits": [
        "base",
        "clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LCART_SANITIZERS": "address;undefined",
        "LCART_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "debug-system",
      "configurePreset": "debug-system"
    },
    {
      "name": "asan-ubsan-system",
      "configurePreset": "asan-ubsan-system"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-system",
      "configurePreset": "debug-system",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "asan-ubsan-system",
      "configurePreset": "asan-ubsan-system",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "clang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "clang-debug"
        },
        {
          "type": "build",
          "name": "clang-debug"
        },
        {
          "type": "test",
          "name": "clang-debug"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "asan-ubsan",
      "steps": [
        {
          "type": "configure",
          "name": "asan-ubsan"
        },
        {
          "type": "build",
          "name": "asan-ubsan"
        },
        {
          "type": "test",
          "name": "asan-ubsan"
        }
      ]
    },
    {
      "name": "debug-system",
      "steps": [
        {
          "type": "configure",
          "name": "debug-system"
        },
        {
          "type": "build",
          "name": "debug-system"
        },
        {
          "type": "test",
          "name": "debug-system"
        }
      ]
    },
    {
      "name": "asan-ubsan-system",
      "steps": [
        {
          "type": "configure",
          "name": "asan-ubsan-system"
        },
        {
          "type": "build",
          "name": "asan-ubsan-system"
        },
        {
          "type": "test",
          "name": "asan-ubsan-system"
        }
      ]
    }
  ]
}
